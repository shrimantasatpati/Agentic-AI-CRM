# Database Configuration
DATABASE_URL=sqlite:///./ai_crm.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_crm

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash
# Grok (xAI) API Configuration
XAI_API_KEY=your-xai-api-key-here
XAI_MODEL_NAME=grok-2-1212
XAI_BASE_URL=https://api.x.ai/v1

# Redis (for caching and message queue)
REDIS_URL=redis://localhost:6379/0

# Email Integration
GMAIL_API_CREDENTIALS=credentials/gmail_credentials.json

# Calendar Integration
GOOGLE_CALENDAR_CREDENTIALS=credentials/calendar_credentials.json

# Application Settings
DEBUG=True
SECRET_KEY=your-secret-key-generate-a-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Agent Configuration
LEAD_QUALIFICATION_ENABLED=true
EMAIL_INTELLIGENCE_ENABLED=true
SALES_PIPELINE_ENABLED=true
CUSTOMER_SUCCESS_ENABLED=true
MEETING_SCHEDULER_ENABLED=true
ANALYTICS_ENABLED=true

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=your-sentry-dsn-if-using

# API Rate Limits
RATE_LIMIT_PER_MINUTE=100
